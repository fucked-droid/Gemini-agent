# ==============================================================================
# LIVE INDIAN MARKET TERMINAL — BROKER & DATA FEED CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: 100% FREE ZERO-AUTH PUBLIC FEED (DEFAULT — NO CREDENTIALS NEEDED)
# ------------------------------------------------------------------------------
# Runs directly with zero account setup, zero API keys, and zero cost.
# Fetches real-time institutional quotes from official NSE India API & Yahoo Finance.
# Bitcoin (BTC/USD 24/7) streams directly from Coinbase WebSocket.
DATA_PROVIDER=PUBLIC

# ------------------------------------------------------------------------------
# OPTION 2: SHOONYA BY FINVASIA (100% FREE BROKER & LIFETIME ZERO BROKERAGE)
# ------------------------------------------------------------------------------
# API Cost: ₹0 / Free forever
# Brokerage: ₹0 across Equity Delivery, Intraday, Futures, and Options
# Account Opening: Free | AMC: ₹0
# To use: Set DATA_PROVIDER=SHOONYA and fill below:
# DATA_PROVIDER=SHOONYA
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_API_KEY=your_shoonya_vendor_code
SHOONYA_TOTP_KEY=your_shoonya_totp_secret_key
SHOONYA_IMEI=WEB_TERMINAL

# ------------------------------------------------------------------------------
# OPTION 3: ANGEL ONE SMARTAPI (FREE API & HIGH-SPEED WEBSOCKETS)
# ------------------------------------------------------------------------------
# API Cost: ₹0 / Free for Angel One demat account holders
# Brokerage: ₹0 Delivery, Flat ₹20 F&O / Intraday
# To use: Set DATA_PROVIDER=ANGEL_ONE and fill below:
# DATA_PROVIDER=ANGEL_ONE
ANGEL_API_KEY=your_angel_smartapi_key
ANGEL_CLIENT_CODE=your_angel_client_code
ANGEL_PIN=your_angel_account_pin
ANGEL_TOTP_SECRET=your_angel_totp_secret_key

# ------------------------------------------------------------------------------
# OPTION 4: DHANHQ API v2 (OPTIONAL BROKER)
# ------------------------------------------------------------------------------
# Free for Dhan Demat account holders for retail personal trading
# DATA_PROVIDER=DHAN
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_WSS_URL=wss://api-feed.dhan.co

# ------------------------------------------------------------------------------
# GENERAL SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
REFRESH_INTERVAL_SECONDS=30
API_RATE_LIMIT_DELAY=0.2
