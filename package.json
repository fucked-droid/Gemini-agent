{
  "name": "market-intelligence-suite",
  "version": "1.0.0",
  "description": "Unified Market & IPO Intelligence Suite with isolated standalone fallback agent.",
  "main": "standalone-agent/index.js",
  "scripts": {
    "test": "npm run test:market && npm run test:ipo",
    "test:market": "python Daily-Market-Regime-Engine/run_all_tests.py",
    "test:ipo": "python IPO-Intelligence-Engine/run_all_tests.py",
    "scan:nifty": "python Daily-Market-Regime-Engine/scan_nifty.py",
    "scan:nifty:update": "python Daily-Market-Regime-Engine/scan_nifty.py --update --news",
    "scan:all": "python Daily-Market-Regime-Engine/scan_nifty.py --update --news",
    "scan:live": "python Daily-Market-Regime-Engine/scan_nifty.py --live",
    "validate:predictions": "python Daily-Market-Regime-Engine/validate_predictions.py",
    "validate:record": "python Daily-Market-Regime-Engine/validate_predictions.py --record",
    "validate:evaluate": "python Daily-Market-Regime-Engine/validate_predictions.py --evaluate",
    "validate:continuous": "python Daily-Market-Regime-Engine/validate_predictions.py --continuous",
    "setup:data": "python Daily-Market-Regime-Engine/setup_clean_data.py --all",
    "data:clean": "python Daily-Market-Regime-Engine/setup_clean_data.py --predictions",
    "data:validate": "python Daily-Market-Regime-Engine/setup_clean_data.py --validate",
    "ipo:scan": "python IPO-Intelligence-Engine/cli.py scan",
    "ipo:active": "python IPO-Intelligence-Engine/cli.py scan --active",
    "ipo:upcoming": "python IPO-Intelligence-Engine/cli.py scan --upcoming",
    "ipo:listing": "python IPO-Intelligence-Engine/cli.py scan --ready-to-list",
    "ipo:live": "python IPO-Intelligence-Engine/cli.py live",
    "ipo:sentinel": "python IPO-Intelligence-Engine/termux_ipo_bot.py",
    "sentinel": "python IPO-Intelligence-Engine/termux_ipo_bot.py",
    "sentinel:watch": "python IPO-Intelligence-Engine/termux_ipo_bot.py --watch",
    "ipo:watch": "python IPO-Intelligence-Engine/src/auto_monitor.py",
    "ipo:telegram": "python IPO-Intelligence-Engine/send_telegram_update.py",
    "agent": "node standalone-agent/index.js",
    "agent:test": "node standalone-agent/cross_platform.test.js"
  },
  "keywords": [
    "nifty",
    "market-regime",
    "ipo-intelligence",
    "gmp",
    "order-flow"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "dotenv": "^18.0.9"
  }
}
